#!/usr/bin/env bash
#
# mytabs — open a standard set of iTerm2 tabs for a Valiant worktree.
#
#   mytabs <directory-name> <colour> [tab-count]
#
# Every tab cds into ~/Projects/valiant-worktrees/<directory-name> and gets the
# same tab colour, then runs whatever its tab set lists for it.
#
# The optional tab-count picks a tab set; anything unrecognised (or nothing at
# all) quietly falls back to the default set. Add a new set by adding a branch
# to set_tab_commands below.
#
# Commands are sent one line at a time rather than chained with &&, so each
# lands as its own shell history entry — quit the rails console and up-arrow
# gets `just au rails c` back, then the colour, then the cd.
#
# Bash rather than zsh on purpose: this is just a wrapper around osascript,
# there's nothing zsh-specific in it, and bash makes it shareable. It sticks
# to bash 3.2 features so it runs on stock macOS /bin/bash too.

set -euo pipefail

WORKTREE_ROOT="$HOME/Projects/valiant-worktrees"
COLOURS="blue yellow orange purple green red grey"

# Populate tab_commands: one entry per tab, in tab order. An entry may hold
# several commands, one per line — they are sent in sequence, each as its own
# command. Leading indentation is stripped, so line them up however reads best.
# An empty entry leaves that tab sitting at a prompt.
set_tab_commands() {
  case "${1:-}" in
    2)
      tab_commands=(
        "just dev --verbose"
        ""
      )
      ;;
    *)
      tab_commands=(
        "just au rails c"
        "pnpm dev"
        "just dev --verbose
         just au worker"
        "tail -f log/development.log"
        ""
      )
      ;;
  esac
}

# Split a tab entry into one command per line, dropping the indentation and any
# blank lines. Prints nothing for an empty entry.
split_commands() {
  echo "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' || true
}

# Render tab_commands for --help, so the two can't drift apart.
list_tabs() {
  local i=1 spec cmds
  for spec in "${tab_commands[@]}"; do
    cmds="$(split_commands "$spec")"
    if [ -z "$cmds" ]; then
      echo "  $i. (nothing — a spare shell)"
    else
      echo "$cmds" | sed "1s/^/  $i. /; 1!s/^/     /"
    fi
    i=$((i + 1))
  done
}

usage() {
  cat <<EOF
Usage: mytabs <directory-name> <colour> [tab-count]

Opens ${#tab_commands[@]} tabs in the current iTerm2 window, all in
$WORKTREE_ROOT/<directory-name>, tinted <colour>:

$(list_tabs)

Tab count: 2 picks the short set; anything else, or nothing, picks the default
set (shown above). Use --dry-run to preview another set's tabs.

Colours: $COLOURS

Options:
  -n, --dry-run   Print what each tab would run, but don't open anything.
  -h, --help      Show this message.
EOF
}

die() {
  echo "mytabs: $*" >&2
  exit 1
}

dry_run=false
show_help=false
args=()
for arg in "$@"; do
  case "$arg" in
    -h|--help)    show_help=true ;;
    -n|--dry-run) dry_run=true ;;
    -*)           die "unknown option '$arg'. Try --help." ;;
    *)            args+=("$arg") ;;
  esac
done

dir_name="${args[0]:-}"
colour="$(echo "${args[1]:-}" | tr '[:upper:]' '[:lower:]')"
tab_count="${args[2]:-}"

set_tab_commands "$tab_count"

if $show_help; then
  usage
  exit 0
fi

if [ "${#args[@]}" -lt 2 ] || [ "${#args[@]}" -gt 3 ]; then
  usage >&2
  exit 1
fi

target="$WORKTREE_ROOT/$dir_name"

# Tab colour, as an RGB triple. Muted rather than saturated so the tab bar
# stays readable.
case "$colour" in
  blue)        r=33;  g=118; b=214 ;;
  yellow)      r=222; g=184; b=16  ;;
  orange)      r=230; g=126; b=34  ;;
  purple)      r=142; g=68;  b=173 ;;
  green)       r=39;  g=148; b=79  ;;
  red)         r=192; g=57;  b=43  ;;
  grey|gray)   r=110; g=110; b=110 ;;
  *)           die "unknown colour '$colour'. Pick one of: $COLOURS" ;;
esac

if [ ! -d "$target" ]; then
  echo "mytabs: no such worktree: $target" >&2
  if [ -d "$WORKTREE_ROOT" ]; then
    echo "Available:" >&2
    ls -1 "$WORKTREE_ROOT" | sed 's/^/  /' >&2
  fi
  exit 1
fi

cd_command="cd $(printf '%q' "$target")"

# iTerm2's proprietary escape code for the tab colour — one sequence per
# channel. Each tab sets its own colour by writing this to its own tty.
colour_command="printf '\\033]6;1;bg;red;brightness;%d\\a\\033]6;1;bg;green;brightness;%d\\a\\033]6;1;bg;blue;brightness;%d\\a' $r $g $b"

# Build each tab's full script: cd, colour, then its own commands. One
# newline-separated string per tab.
tab_scripts=()
for spec in "${tab_commands[@]}"; do
  script="$cd_command"$'\n'"$colour_command"
  cmds="$(split_commands "$spec")"
  [ -n "$cmds" ] && script="$script"$'\n'"$cmds"
  tab_scripts+=("$script")
done

if $dry_run; then
  i=1
  for script in "${tab_scripts[@]}"; do
    echo "tab $i:"
    echo "$script" | sed 's/^/  /'
    i=$((i + 1))
  done
  exit 0
fi

# One osascript argument per tab, holding that tab's newline-separated
# commands. Passing them as arguments means nothing needs escaping into the
# AppleScript source itself.
osascript - "${tab_scripts[@]}" <<'APPLESCRIPT'
on setUpSession(theSession, theScript)
	set savedDelimiters to AppleScript's text item delimiters
	set AppleScript's text item delimiters to linefeed
	set theCommands to text items of theScript
	set AppleScript's text item delimiters to savedDelimiters

	tell application "iTerm2"
		tell theSession
			-- One write per command, so each lands as its own shell history
			-- entry and up-arrow walks back through them.
			repeat with theCommand in theCommands
				write text (theCommand as text)
			end repeat
		end tell
	end tell
end setUpSession

on run argv
	tell application "iTerm2"
		activate
		if (count of windows) is 0 then
			-- No window to add to, so make one. It comes with a tab already,
			-- which takes the first tab's commands; the rest get new tabs.
			set theWindow to (create window with default profile)
			my setUpSession(current session of current tab of theWindow, item 1 of argv as text)
			set theScripts to rest of argv
		else
			set theWindow to current window
			set theScripts to argv
		end if

		repeat with theScript in theScripts
			tell theWindow
				set theTab to (create tab with default profile)
			end tell
			my setUpSession(current session of theTab, theScript as text)
		end repeat
	end tell
end run
APPLESCRIPT
